# ARIA Environment Configuration Example
# Copy to .env for local overrides (never commit secrets or wifi credentials)

ARIA_MQTT_HOST=127.0.0.1
ARIA_MQTT_PORT=1883

# NVIDIA NIM API (Advice Engine AI guidance)
# Obtain an API key from https://build.nvidia.com
NVIDIA_API_KEY=key

# Optional: Override the model (defaults to meta/llama-3.1-8b-instruct)
# To use Nemotron 3.5:
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_MAX_TOKENS=4096

